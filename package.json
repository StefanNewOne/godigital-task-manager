{
  "name": "godigital-task-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GoDigital Task Manager — интерен таск-менаџер за видео и графика",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:generate": "pnpm --filter @gd/db generate",
    "db:migrate": "pnpm --filter @gd/db migrate",
    "db:deploy": "pnpm --filter @gd/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @gd/db seed",
    "db:demo": "pnpm --filter @gd/db exec tsx prisma/demo-seed.ts",
    "db:setup": "pnpm db:deploy && pnpm db:seed",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.15.0",
    "@gd/eslint-plugin": "workspace:*",
    "@playwright/test": "^1.63.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
