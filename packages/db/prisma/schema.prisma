// ─────────────────────────── Core structural models ───────────────────────────

model Client {
  id                   String       @id @default(uuid(7)) @db.Uuid
  tenantId             String       @default("godigital")
  name                 String
  legalName            String?
  logoFileId           String?      @db.Uuid
  color                String
  status               ClientStatus @default(aktiven)
  contractStart        DateTime     @db.Date
  contractMonths       Int
  videosPerMonth       Int          @default(0)
  graphicsPerMonth     Int          @default(0)
  usesMetaAds          Boolean      @default(false)
  metaAdAccountId      String?
  metaPageId           String?
  metaIgId             String?
  calendarType         CalendarType @default(standarden)
  approvalChannel      Channel      @default(viber)
  coverageAlarmDays    Int          @default(7)
  notes                String?
  defaultAssignees     Json?
  archivedAt           DateTime?
  // Директор „гаси" клиент: датумите може да се активираат/закажат само до крај на месецот
  // на гасењето (clientActiveForDate во @gd/core). null = активен.
  deactivatedAt        DateTime?
  // Модул 3 · Мета — профил (цели, прагови, белешки). §4.1. Уредува само Директор.
  metaTargetText       String?
  metaTargetValue      Decimal?     @db.Decimal(12, 2)
  metaTargetMetric     String?
  metaMaxDailyBudget   Decimal?     @db.Decimal(12, 2)
  metaFreqThreshold    Decimal      @default(3.0) @db.Decimal(5, 2)
  metaCprAlertPct      Int          @default(40)
  metaNamingConvention String?
  metaNotes            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  contacts          ClientContact[]
  calendarConfigs   CalendarConfig[]
  holidays          Holiday[]
  slots             PublishingSlot[]
  taskGroups        TaskGroup[]
  tasks             Task[]
  campaigns         Campaign[]
  moduleAssignments ModuleAssignment[]
  publications      Publication[]
  pageSnapshots     PageSnapshot[]

  @@index([tenantId])
}

model ClientContact {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @default("godigital")
  clientId     String    @db.Uuid
  client       Client    @relation(fields: [clientId], references: [id])
  name         String
  roleAtClient String?
  phone        String?
  email        String?
  isApprover   Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  magicTokens ClientMagicToken[]

  @@index([clientId])
}

model Employee {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @default("godigital")
  name              String
  email             String    @unique
  passwordHash      String
  phone             String?
  role              Role
  isScenaristToo    Boolean   @default(false)
  color             String
  active            Boolean   @default(true)
  capacityNote      String?
  notificationPrefs Json?
  googleSub         String?   @unique // Google subject (ADR-002) — врзување при Google најава
  lastActiveAt      DateTime?
  createdById       String?   @db.Uuid
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // DB check (миграција): isScenaristToo = true само ако role = 'rez'.

  resetTokens PasswordResetToken[]

  @@index([tenantId])
}

// Заборавена лозинка (H4): еднократен токен со рок. Се чува САМО hash на токенот (§12).
model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @default("godigital")
  employeeId String    @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id])
  tokenHash  String // sha-256 hex на опаковиот токен; никогаш plaintext
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([tenantId])
}

// Фаза D (клиентски PWA): magic-link токен за ClientContact. Само hash (§12), еднократен, TTL.
model ClientMagicToken {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @default("godigital")
  clientContactId String        @db.Uuid
  contact         ClientContact @relation(fields: [clientContactId], references: [id])
  tokenHash       String // sha-256 hex; никогаш plaintext
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([clientContactId])
  @@index([tenantId])
}

model CalendarConfig {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @default("godigital")
  // null = СТАНДАРДЕН календар за tenant (важи за клиенти со calendarType=standarden);
  // не-null = посебен календар за конкретен клиент (override).
  clientId       String?     @db.Uuid
  client         Client?     @relation(fields: [clientId], references: [id])
  contentType    ContentType
  weekdays       Int[] // 1=пон … 7=нед
  publishTime    String // "HH:mm"
  allowTwoPerDay Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Партиален unique за стандардниот (clientId IS NULL) е во миграцијата (Prisma нема филтриран unique).
  @@unique([clientId, contentType])
}

model Holiday {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @default("godigital")
  date      DateTime     @db.Date
  name      String
  scope     HolidayScope @default(global)
  clientId  String?      @db.Uuid
  client    Client?      @relation(fields: [clientId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([date, clientId])
}

model PublishingSlot {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @default("godigital")
  clientId         String      @db.Uuid
  client           Client      @relation(fields: [clientId], references: [id])
  contentType      ContentType
  date             DateTime    @db.Date
  orderInDay       Int         @default(1)
  status           SlotStatus  @default(predlog)
  monthKey         String // "2026-10"
  carriedFromMonth String?
  task             Task?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([clientId, contentType, date, orderInDay])
  @@index([clientId, monthKey])
}

model TaskGroup {
  id                 String      @id @default(uuid(7)) @db.Uuid
  tenantId           String      @default("godigital")
  clientId           String      @db.Uuid
  client             Client      @relation(fields: [clientId], references: [id])
  contentType        ContentType
  monthKey           String
  status             GroupStatus
  plannedCount       Int         @default(0)
  scenaristId        String?     @db.Uuid
  rezId              String?     @db.Uuid
  kamId              String?     @db.Uuid
  shootDate          DateTime? // timestamptz, Europe/Skopje
  shootLocation      String?
  scenaristNotes     String?
  scenarioDocVersion Int         @default(0)
  closedAt           DateTime?
  rawDeleteAt        DateTime?
  rawExtendedTimes   Int         @default(0)
  localArchivePath   String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tasks     Task[]
  scenarios Scenario[]
  comments  Comment[]
  shoots    ShootSession[]

  @@unique([clientId, contentType, monthKey])
}

enum ShootKind {
  primary
  additional
}

/**
 * Термин на снимање за видео капа (B-редизајн). Основниот се создава при podgotovka→scenarija;
 * дополнителните ги додава Камерман во статус snimanje. „Календар на снимање" чита од тука.
 */
model ShootSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default("godigital")
  groupId   String    @db.Uuid
  group     TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId  String    @db.Uuid
  date      DateTime // timestamptz (датум + час), Europe/Skopje
  location  String
  kind      ShootKind @default(additional)
  createdAt DateTime  @default(now())

  @@index([tenantId, date])
  @@index([groupId])
}

model Task {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @default("godigital")
  groupId          String          @db.Uuid
  group            TaskGroup       @relation(fields: [groupId], references: [id])
  clientId         String          @db.Uuid
  client           Client          @relation(fields: [clientId], references: [id])
  contentType      ContentType
  title            String
  titleIsAuto      Boolean         @default(true)
  status           TaskStatus
  pausedFromStatus TaskStatus?
  slotId           String?         @unique @db.Uuid
  slot             PublishingSlot? @relation(fields: [slotId], references: [id])
  scenarioId       String?         @unique @db.Uuid
  scenario         Scenario?       @relation(fields: [scenarioId], references: [id])
  assigneeId       String?         @db.Uuid
  rezId            String?         @db.Uuid
  kreaId           String?         @db.Uuid
  monId            String?         @db.Uuid
  dizId            String?         @db.Uuid
  brief            String?
  copy             String?
  priority         Priority        @default(normalen)
  version          Int             @default(1)
  isExtra          Boolean         @default(false)
  statusChangedAt  DateTime        @default(now())
  postUnavailable  Boolean         @default(false)
  cancelReason     String?
  pauseReason      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  revisions    Revision[]
  comments     Comment[]
  publications Publication[]

  @@index([tenantId, status])
  @@index([clientId, contentType])
  @@index([assigneeId])
}

model Scenario {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @default("godigital")
  groupId       String         @db.Uuid
  group         TaskGroup      @relation(fields: [groupId], references: [id])
  ordinal       Int
  docVersion    Int            @default(1)
  title         String
  hook          String?
  body          String?
  notes         String?
  status        ScenarioStatus @default(predlozeno)
  clientComment String?
  source        String         @default("manual") // manual | ai
  task          Task?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([groupId, ordinal, docVersion])
}

model Revision {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @default("godigital")
  taskId       String         @db.Uuid
  task         Task           @relation(fields: [taskId], references: [id])
  version      Int
  returnedById String?        @db.Uuid
  role         Role?
  comment      String
  source       RevisionSource
  fileId       String?        @db.Uuid
  createdAt    DateTime       @default(now())

  @@index([taskId])
}

model Approval {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @default("godigital")
  objectType       ApprovalObjectType
  objectId         String             @db.Uuid
  type             ApprovalType
  outcome          ApprovalOutcome
  enteredById      String?            @db.Uuid
  enteredByRole    Role?
  onBehalfOfRole   Role?
  channel          Channel?
  comment          String?
  attachmentFileId String?            @db.Uuid
  source           ApprovalSource     @default(employee)
  createdAt        DateTime           @default(now())

  @@index([objectType, objectId])
}

model Comment {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @default("godigital")
  taskId    String?     @db.Uuid
  task      Task?       @relation(fields: [taskId], references: [id])
  groupId   String?     @db.Uuid
  group     TaskGroup?  @relation(fields: [groupId], references: [id])
  authorId  String      @db.Uuid
  body      String
  mentions  String[]
  kind      CommentKind @default(comment)
  createdAt DateTime    @default(now())

  @@index([taskId])
  @@index([groupId])
}

model Publication {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @default("godigital")
  // Објава преку апката е врзана за таск; backfill-ирана објава (директно од сметката, B2)
  // е account-ниво — без таск, но со директен clientId.
  taskId          String?             @db.Uuid
  task            Task?               @relation(fields: [taskId], references: [id])
  clientId        String?             @db.Uuid
  client          Client?             @relation(fields: [clientId], references: [id])
  platform        PublicationPlatform
  postType        PostType
  publishedAt     DateTime?
  permalink       String?
  externalRef     String?
  metaMediaId     String?
  resolveStatus   ResolveStatus       @default(pending)
  publishedById   String?             @db.Uuid
  // Модул 3 · Мета (§4.3): органиката се реупотребува како Publication.
  mediaType       String?
  caption         String?
  thumbnailFileId String?             @db.Uuid
  promotion       Promotion?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Task-објави: една по (task, платформа). Backfill unique (clientId, platform, externalRef)
  // е партиален индекс во миграцијата (Prisma нема филтриран unique).
  @@unique([taskId, platform])
}

model Campaign {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @default("godigital")
  clientId       String         @db.Uuid
  client         Client         @relation(fields: [clientId], references: [id])
  name           String
  metaCampaignId String?
  objective      String
  budget         Decimal        @db.Decimal(12, 2)
  periodFrom     DateTime       @db.Date
  periodTo       DateTime       @db.Date
  status         CampaignStatus @default(planned)
  analystId      String?        @db.Uuid
  promotions     Promotion[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
}

model Promotion {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @default("godigital")
  publicationId String            @unique @db.Uuid
  publication   Publication       @relation(fields: [publicationId], references: [id])
  decision      PromotionDecision
  rationale     String?
  campaignId    String?           @db.Uuid
  campaign      Campaign?         @relation(fields: [campaignId], references: [id])
  decidedById   String?           @db.Uuid
  decidedAt     DateTime          @default(now())
}

// MetricSnapshot — append-only (без UPDATE/DELETE grant; спроведено во миграција).
/**
 * FB page-ниво метрики (B2). Reach/impressions по страница се укинати од Meta (v21), па се
 * снимаат само достапните: followers, ангажман, page views, нови follows, video views, реакции.
 * Append-only временска серија (како MetricSnapshot).
 */
model PageSnapshot {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default("godigital")
  clientId   String   @db.Uuid
  client     Client   @relation(fields: [clientId], references: [id])
  capturedAt DateTime @default(now())
  followers  Int?
  engagement Int?
  pageViews  Int?
  newFollows Int?
  videoViews Int?
  reactions  Int?
  raw        Json

  @@index([clientId, capturedAt])
}

model MetricSnapshot {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default("godigital")
  publicationId String?  @db.Uuid
  campaignId    String?  @db.Uuid
  capturedAt    DateTime @default(now())
  raw           Json
  reach         Decimal? @db.Decimal(14, 2)
  impressions   Decimal? @db.Decimal(14, 2)
  views         Decimal? @db.Decimal(14, 2)
  engagement    Decimal? @db.Decimal(14, 2)
  spend         Decimal? @db.Decimal(12, 2)
  cpr           Decimal? @db.Decimal(12, 4)
  ctr           Decimal? @db.Decimal(8, 4)
  frequency     Decimal? @db.Decimal(8, 4)

  @@index([publicationId, capturedAt])
  @@index([campaignId, capturedAt])
}

model FileAsset {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @default("godigital")
  ownerType     FileOwnerType
  ownerId       String        @db.Uuid
  kind          FileKind
  r2Key         String
  size          BigInt
  mime          String
  version       Int?
  previewFileId String?       @db.Uuid
  lifecycle     FileLifecycle @default(active)
  deleteAt      DateTime?
  uploadedById  String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ownerType, ownerId])
}

model UploadSession {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @default("godigital")
  fileAssetId String       @db.Uuid
  r2UploadId  String
  parts       Json
  status      UploadStatus @default(open)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
}

model DateChange {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default("godigital")
  taskId        String   @db.Uuid
  oldSlotId     String?  @db.Uuid
  newSlotId     String?  @db.Uuid
  reason        String
  changedById   String?  @db.Uuid
  changedByRole Role?
  createdAt     DateTime @default(now())

  @@index([taskId])
}

model StatusDeadlineConfig {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @default("godigital")
  scope       DeadlineScope  @default(global)
  clientId    String?        @db.Uuid
  target      DeadlineTarget
  contentType ContentType
  status      String // TaskStatus или GroupStatus клуч
  leadDays    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([scope, clientId, target, contentType, status])
}

model AutomationRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @default("godigital")
  name        String
  scope       String          @default("global") // global | client
  clientId    String?         @db.Uuid
  trigger     Json
  conditions  Json
  actions     Json
  enabled     Boolean         @default(true)
  isSystem    Boolean         @default(false)
  createdById String?         @db.Uuid
  archivedAt  DateTime? // soft-delete (И6); системските правила не се архивираат
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AutomationRun[]

  @@index([tenantId])
}

model AutomationRun {
  id       String         @id @default(uuid(7)) @db.Uuid
  tenantId String         @default("godigital")
  ruleId   String         @db.Uuid
  rule     AutomationRule @relation(fields: [ruleId], references: [id])
  taskId   String?        @db.Uuid
  groupId  String?        @db.Uuid
  ranAt    DateTime       @default(now())
  result   String // ok | rejected | error
  detail   Json?

  @@index([ruleId])
}

model ModuleAssignment {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @default("godigital")
  clientId     String     @db.Uuid
  client       Client     @relation(fields: [clientId], references: [id])
  module       ModuleKind
  active       Boolean    @default(true)
  assignedById String?    @db.Uuid
  assignedAt   DateTime   @default(now())

  @@unique([clientId, module])
}

model Notification {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @default("godigital")
  recipientId  String            @db.Uuid
  level        NotificationLevel
  eventKey     String
  taskId       String?           @db.Uuid
  groupId      String?           @db.Uuid
  clientId     String?           @db.Uuid
  title        String
  body         String
  channelsSent Json?
  readAt       DateTime?
  dedupeKey    String            @unique
  createdAt    DateTime          @default(now())

  @@index([recipientId, readAt])
}

model SavedView {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default("godigital")
  employeeId String   @db.Uuid
  screen     String
  name       String
  filters    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, screen])
}

// EventLog — append-only (без UPDATE/DELETE grant за апликацискиот DB корисник).
model EventLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default("godigital")
  eventType      String
  objectType     String
  objectId       String
  clientId       String?  @db.Uuid
  taskId         String?  @db.Uuid
  groupId        String?  @db.Uuid
  actorId        String?  @db.Uuid
  actorRole      String?
  onBehalfOfRole String?
  occurredAt     DateTime @default(now())
  oldValue       Json?
  newValue       Json?
  context        Json?
  narrative      String

  outbox Outbox[]

  @@index([tenantId, objectType, objectId])
  @@index([tenantId, occurredAt])
}

// Outbox — образец за real-time / знаење / известувања (без dual write).
model Outbox {
  id          String     @id @default(uuid(7)) @db.Uuid
  eventLogId  String     @db.Uuid
  eventLog    EventLog   @relation(fields: [eventLogId], references: [id])
  kind        OutboxKind
  processedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([kind, processedAt])
}

model KnowledgeChunk {
  id              String                       @id @default(uuid(7)) @db.Uuid
  tenantId        String                       @default("godigital")
  sourceType      KnowledgeSource
  sourceId        String
  clientId        String?                      @db.Uuid
  taskId          String?                      @db.Uuid
  groupId         String?                      @db.Uuid
  visibility      Visibility                   @default(internal)
  occurredAt      DateTime
  text            String
  metadata        Json
  contentHash     String
  embedding       Unsupported("vector(1024)")?
  tsv             Unsupported("tsvector")?
  embeddingStatus EmbStatus                    @default(pending)
  embeddingModel  String?
  createdAt       DateTime                     @default(now())
  // HNSW (embedding) + GIN (tsv) индекси се додаваат преку raw SQL во миграцијата.

  @@unique([sourceType, sourceId, contentHash])
  @@index([clientId, sourceType, occurredAt])
}

// Месечен план на клиенти — Директорот одобрува кои клиенти се работат за даден месец
// (до 15-ти; аларм ако касни). Мек гејт: важи само за месеци со потврден план.
model MonthlyPlan {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @default("godigital")
  monthKey      String
  confirmedById String?             @db.Uuid
  confirmedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  clients       MonthlyPlanClient[]

  @@unique([tenantId, monthKey])
  @@index([tenantId, monthKey])
}

model MonthlyPlanClient {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @default("godigital")
  monthlyPlanId String      @db.Uuid
  plan          MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  clientId      String      @db.Uuid
  active        Boolean     @default(true)

  @@unique([monthlyPlanId, clientId])
  @@index([tenantId, clientId])
}

// Идемпотентност за офлајн replay (Фаза C3) — ист Idempotency-Key враќа истиот одговор.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default("godigital")
  key          String   @unique
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Web Push претплата по вработен-уред (Фаза C5). Едно endpoint = еден уред/прелистувач.
model PushSubscription {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default("godigital")
  employeeId String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([tenantId, employeeId])
}

// ─────────────────────────── Модул 2 · Продажен CRM ───────────────────────────
// Лид од прв контакт до активација. Статусот се менува САМО преку @gd/core `CRM_TRANSITIONS`
// (transitionLead сервис) — никогаш директен update. Активноста/аудитот се во EventLog
// (objectType='lead'). Пакет-полињата се преслика 1:1 во Client при активација.
model Lead {
  id       String     @id @default(uuid(7)) @db.Uuid
  tenantId String     @default("godigital")
  name     String
  status   LeadStatus @default(novLid)
  source   String
  // Продажен агент-сопственик (Employee.role='sales'). Само тој дејствува во своите чекори.
  agentId  String     @db.Uuid

  // Контакт
  person  String
  phone   String?
  email   String?
  pkgHint String  @default("—")

  // Параметри на пакетот (чекор 7) — се преслика 1:1 во Client при активација.
  pkgVideos   Int          @default(0)
  pkgGraphics Int          @default(0)
  pkgMeta     Boolean      @default(false)
  pkgStart    String? // стартен месец "YYYY-MM"
  pkgMonths   Int          @default(0)
  pkgCalType  CalendarType @default(specificen)

  // Состанок (чекор 6). No-show ги ресетира date/time/held.
  meetingDate        DateTime?
  meetingTime        String?
  meetingPlace       String?
  meetingHeld        Boolean   @default(false)
  meetingNotes       String?
  meetingAudioFileId String?   @db.Uuid

  // Документи (presigned R2, И7). Верзиите се во LeadOffer/LeadContract.
  analysisFileId String? @db.Uuid
  signedFileId   String? @db.Uuid
  strategyFileId String? @db.Uuid
  fableFileId    String? @db.Uuid

  // Изгубен лид (само од чекор 5/9). За причина „Друго" белешката е задолжителна.
  lostFromStatus LeadStatus?
  lossReason     String?
  lossNote       String?

  // Стандарден тим при активација — {am,rez,krea,ana: employeeId|null}. Само директор го менува во чекор 11.
  team Json?

  // Активиран клиент (Модул 1) создаден при чекор 11.
  activatedClientId String? @db.Uuid

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  offers      LeadOffer[]
  contracts   LeadContract[]
  planEntries ContentPlanEntry[]

  @@index([tenantId, status])
  @@index([tenantId, agentId])
}

// Интерни верзии на понудата. Клиентот ја гледа само финалната. `ret` = врата од директор,
// `clientRet` = клиентот бара измени — секоја бара нова верзија (v+1).
model LeadOffer {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default("godigital")
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  version   Int
  fileId    String?  @db.Uuid
  ret       String?
  clientRet String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, version])
  @@index([tenantId, leadId])
}

// Интерни верзии на договорот (иста семантика како LeadOffer).
model LeadContract {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default("godigital")
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  version   Int
  fileId    String?  @db.Uuid
  ret       String?
  clientRet String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, version])
  @@index([tenantId, leadId])
}

// Content планер (чекор 10) — еден запис по закажан ден. Бројот по месец/тип е ДЕРИВИРАН
// (И3), не се складира. При активација датумите од првиот месец стануваат мртви слотови.
model ContentPlanEntry {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @default("godigital")
  leadId      String      @db.Uuid
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  monthKey    String // "2026-10"
  day         Int // ден во месец 1..31
  contentType ContentType
  createdAt   DateTime    @default(now())

  @@unique([leadId, monthKey, day])
  @@index([tenantId, leadId])
}

// ─────────────────────────── Модул 3 · Мета (META_TECH_SPEC §4) ───────────────────────────
// Само за читање кон Meta. Огледало на рекламната структура + insights + инбокс + алерти +
// планови за промена. Сè се врзува преку Meta ID, никогаш преку име (PRD §5).

enum MetaConnKind {
  adAccount
  page
  igAccount
  pixel
  catalog
}

enum MetaAccessLevel {
  write
  read
  none
}

enum ObjectiveKey {
  msg
  thru
  cart
  buy
  reach
  traffic
  lead
  leadWeb
}

enum MetaInsightLevel {
  campaign
  adset
  ad
}

enum MetaConvChannel {
  messenger
  instagram
}

enum MetaCommentParent {
  ad
  post
}

enum MetaAlertSeverity {
  crit
  high
  mid
  info
}

enum MetaAlertState {
  new
  seen
  snoozed
  resolved
}

enum MetaPlanOp {
  O1
  O2
  O3
  O4
  O5
  O6
  O7
  O8
  O9
  O10
  O11
  O12
}

enum MetaPlanStatus {
  pending
  approved
  syncing
  done
  rejected
  mismatch
  withdrawn
}

enum MetaPlanVia {
  manual
  assistant
}

// Асет на клиент (адаптибилно на повеќе по клиент; UI прикажува еден засега — §4.1).
model MetaConnection {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @default("godigital")
  clientId          String          @db.Uuid
  kind              MetaConnKind
  metaId            String
  name              String?
  currency          String? // само adAccount (EUR/USD)
  accessLevel       MetaAccessLevel @default(read)
  igMessagesEnabled Boolean?
  spendCap          Decimal?        @db.Decimal(14, 2)
  amountSpent       Decimal?        @db.Decimal(14, 2)
  accountStatus     String?
  disableReason     String?
  lastSyncAt        DateTime?
  lastSyncError     String?
  syncFailCount     Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  campaigns MetaCampaign[]

  @@unique([clientId, kind, metaId])
  @@index([tenantId, clientId])
}

model MetaCampaign {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @default("godigital")
  clientId         String         @db.Uuid
  connectionId     String         @db.Uuid
  connection       MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  metaId           String         @unique
  name             String
  objective        String
  objectiveKey     ObjectiveKey?
  buyingType       String?
  budgetStrategy   String? // CBO/ABO
  dailyBudget      Decimal?       @db.Decimal(12, 2)
  bidStrategy      String?
  status           String?
  effectiveStatus  String?
  startTime        DateTime?
  stopTime         DateTime?
  pausedExternally Boolean        @default(false)
  raw              Json?
  syncedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  adSets MetaAdSet[]

  @@index([tenantId, clientId])
}

model MetaAdSet {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @default("godigital")
  campaignId         String       @db.Uuid
  campaign           MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metaId             String       @unique
  name               String
  status             String?
  effectiveStatus    String?
  optimizationGoal   String?
  conversionLocation String?
  destination        String?
  targeting          Json?
  placements         Json?
  learningStage      String?
  learningStageSince DateTime?
  raw                Json?
  syncedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ads MetaAd[]

  @@index([tenantId, campaignId])
}

model MetaAd {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default("godigital")
  adSetId          String    @db.Uuid
  adSet            MetaAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  metaId           String    @unique
  name             String
  status           String?
  effectiveStatus  String?
  reviewStatus     String? // approved|rejected|pending|no_delivery
  reviewFeedback   Json?
  creativeId       String?
  sourcePostMetaId String?
  publicationId    String?   @db.Uuid // врска кон Publication → Task (scalar, без relation)
  cta              String?
  messageTemplate  String?
  enhancements     Json?
  raw              Json?
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, adSetId])
  @@index([publicationId])
}

// Дневни insights по ниво/објект (upsert по ден). Последните 7 дена isFinal=false.
model MetaInsightDaily {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @default("godigital")
  level        MetaInsightLevel
  objectMetaId String
  clientId     String           @db.Uuid
  date         DateTime         @db.Date
  spend        Decimal          @default(0) @db.Decimal(14, 2)
  impressions  Int              @default(0)
  reach        Int              @default(0)
  frequency    Decimal          @default(0) @db.Decimal(8, 4)
  clicks       Int              @default(0)
  ctr          Decimal          @default(0) @db.Decimal(8, 4)
  results      Decimal          @default(0) @db.Decimal(14, 2)
  resultType   String?
  actions      Json?
  raw          Json?
  fetchedAt    DateTime         @default(now())
  isFinal      Boolean          @default(false)

  @@unique([level, objectMetaId, date])
  @@index([tenantId, clientId, date])
}

model MetaConversation {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @default("godigital")
  clientId        String          @db.Uuid
  connectionId    String          @db.Uuid
  metaThreadId    String          @unique
  channel         MetaConvChannel
  participantName String?
  sourceAdMetaId  String?
  lastMessageAt   DateTime?
  unread          Boolean         @default(false)
  waitingSince    DateTime?
  topic           String?
  tags            String[]        @default([])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages MetaMessage[]

  @@index([tenantId, clientId])
}

model MetaMessage {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @default("godigital")
  conversationId String           @db.Uuid
  conversation   MetaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metaMessageId  String           @unique
  fromPage       Boolean          @default(false)
  text           String?
  sentAt         DateTime?
  viaTemplate    String?
  bodyPurgedAt   DateTime? // по 12 месеци текстот се брише, бројките остануваат
  createdAt      DateTime         @default(now())

  @@index([tenantId, conversationId])
}

model MetaComment {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @default("godigital")
  clientId         String            @db.Uuid
  metaCommentId    String            @unique
  parentObjectType MetaCommentParent
  parentMetaId     String
  publicationId    String?           @db.Uuid
  adId             String?           @db.Uuid
  authorName       String?
  text             String?
  createdTime      DateTime?
  isQuestion       Boolean           @default(false)
  isComplaint      Boolean           @default(false)
  tags             String[]          @default([])
  createdAt        DateTime          @default(now())

  @@index([tenantId, clientId])
}

model MetaAlert {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @default("godigital")
  clientId     String            @db.Uuid
  code         String // A01…A13
  severity     MetaAlertSeverity
  objectType   String?
  objectMetaId String?
  title        String
  detail       String?
  deepLink     Json?
  state        MetaAlertState    @default(new)
  snoozedUntil DateTime?
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  occurrences  Int               @default(1)
  dedupeKey    String            @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, clientId, state])
}

// План за промена (P-###). Извршува човек во Ads Manager; sync потврдува.
model MetaChangePlan {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @default("godigital")
  clientId       String         @db.Uuid
  op             MetaPlanOp
  target         Json // {campaignId?, adSetId?, adId?}
  params         Json?
  before         Json?
  after          Json?
  consequences   String[]       @default([])
  warnings       String[]       @default([])
  status         MetaPlanStatus @default(pending)
  createdById    String         @db.Uuid
  createdVia     MetaPlanVia    @default(manual)
  command        String?
  note           String?
  rejectNote     String?
  taskId         String?        @db.Uuid
  promotionId    String?        @db.Uuid
  approvedById   String?        @db.Uuid
  approvedAt     DateTime?
  markedDoneAt   DateTime?
  confirmedAt    DateTime?
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, clientId, status])
  @@index([tenantId, createdById])
}
