# ─────────────────────────────────────────────────────────────
# GoDigital Task Manager — environment variables (example)
# Copy to .env.local and fill in. NEVER commit real values.
# App refuses to start (Zod validation) if a required var is missing.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
TZ=Europe/Skopje

# --- Database (PostgreSQL 16 + pgvector) ---
# Host port 5532 (не 5432) за да коегзистира со другите локални Docker стекови.
DATABASE_URL=postgresql://gd:gd@localhost:5532/godigital?schema=public

# --- Redis (cache + BullMQ) ---
REDIS_URL=redis://localhost:6479

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Default tenant (tenant-ready; single tenant today) ---
DEFAULT_TENANT_ID=godigital

# --- API / Web ---
API_PORT=3001
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001

# --- Object storage (Cloudflare R2 in prod; MinIO locally) ---
R2_ENDPOINT=http://localhost:9100
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=godigital
R2_PUBLIC_URL=http://localhost:9100/godigital

# --- Email (Mailhog locally) ---
SMTP_HOST=localhost
SMTP_PORT=1135
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@godigital.mk

# --- Cron trigger secret (HTTP-triggered jobs) ---
CRON_SECRET=change-me-cron-secret

# --- Embedding provider (Phase B4; D-10: Voyage voyage-multilingual-2, 1024 dim) ---
EMBED_PROVIDER=voyage
EMBED_MODEL=voyage-multilingual-2
EMBED_DIM=1024
VOYAGE_API_KEY=

# --- Claude API (Phase B4+; ONLY via backend proxy) ---
ANTHROPIC_API_KEY=

# --- Meta Graph API (Phase B2) ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_TOKEN=

# --- SMS for critical alarms (Phase B1; D-12: no Viber) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DIRECTOR_PHONE=
