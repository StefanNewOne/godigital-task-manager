# .env.staging (ПРИМЕР) — копирај во .env.staging на VPS и пополни. НИКОГАШ committed.
# ── домен / едге ──
STAGING_DOMAIN=staging.example.mk
WEB_ORIGIN=https://staging.example.mk

# ── база (во compose) ──
POSTGRES_USER=gd
POSTGRES_PASSWORD=__smeni__
POSTGRES_DB=godigital
DATABASE_URL=postgresql://gd:__smeni__@postgres:5432/godigital?schema=public

# ── redis (во compose) ──
REDIS_URL=redis://redis:6379

# ── storage (MinIO во compose) ──
R2_ENDPOINT=http://minio:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=gdminio
R2_SECRET_ACCESS_KEY=__smeni__
R2_BUCKET=godigital
R2_PUBLIC_URL=https://staging.example.mk/files

# ── auth (генерирај силни: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=__smeni__
JWT_REFRESH_SECRET=__smeni__
CRON_SECRET=__smeni__
NODE_ENV=production

# ── email (SMTP; или Mailhog за staging) ──
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=GoDigital <no-reply@godigital.mk>

# ── Meta (B2) ──
META_SYSTEM_TOKEN=
META_GRAPH_VERSION=v21.0

# ── AI (Claude преку CLI/претплата) ──
CLAUDE_MODE=cli
CLAUDE_CLI_PATH=claude
# Генерирано со: claude setup-token  (долготраен headless токен)
CLAUDE_CODE_OAUTH_TOKEN=

# ── Web Push (C5) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@godigital.mk
